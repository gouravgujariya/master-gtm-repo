{
  "name": "krishna-gtm-repo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cold-outbound GTM system \u2014 scripts for sourcing, verification, and campaign ops.",
  "scripts": {
    "verify-emails": "tsx skills/agenticdata-contacts/scripts/verify-emails.ts",
    "check-credits": "tsx skills/agenticdata-contacts/scripts/verify-emails.ts --credits",
    "select-contacts": "tsx skills/agenticdata-contacts/scripts/select-contacts.ts",
    "ai-ark": "tsx skills/agenticdata-contacts/scripts/ai-ark.ts",
    "coldiq": "tsx skills/agenticdata-contacts/scripts/coldiq-find.ts",
    "bulk-list": "tsx skills/bulk-list-builder/scripts/query.ts",
    "supabase-sample": "tsx scripts/supabase-sample.ts",
    "supabase-upload": "tsx scripts/supabase-upload.ts",
    "supabase-push": "tsx scripts/supabase-push-contacts.ts",
    "supabase-push-companies": "tsx scripts/supabase-push-companies.ts",
    "plusvibe-upload": "tsx scripts/plusvibe-upload.ts",
    "agenticdata-find": "tsx skills/agenticdata-contacts/scripts/agenticdata-find.ts",
    "new-client": "tsx scripts/new-client.ts",
    "research": "tsx scripts/research.ts",
    "app": "tsx app/server.ts",
    "start": "tsx src/api-main.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.development src/db/migrate.ts",
    "db:migrate:prod": "tsx --env-file=.env.production src/db/migrate.ts",
    "import:fs": "tsx --env-file=.env.development scripts/import-fs.ts",
    "worker": "tsx src/worker-main.ts",
    "dev:api": "tsx watch --env-file=.env.development src/api-main.ts",
    "dev:worker": "tsx watch --env-file=.env.development src/worker-main.ts",
    "dev": "npm run dev:api & npm run dev:worker & wait",
    "db:migrate:deploy": "tsx src/db/migrate.ts",
    "user:add": "tsx --env-file=.env.development scripts/add-user.ts",
    "user:add:deploy": "tsx scripts/add-user.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.314",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@types/node": "^22.10.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
