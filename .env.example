# Krishna GTM Repo — Environment Variables (TEMPLATE)
#
# Copy this file to .env and fill in the keys for the tools you use.
# .env is git-ignored; this .env.example is COMMITTED — keep it blank (never paste real keys here).
#
# Default path needs: AgenticData (MCP) + Apify + Serper.dev + FireCrawl + OptimaVerifier + Plusvibe + Inboxkit + Supabase

# ============================================================
# CONTACTS — find decision-makers + emails (waterfall)
# ============================================================
# AgenticData — PRIMARY (already MCP-connected). Key only for HTTP fallback. Format: ADATA_live_...
ADATA_API_KEY=
# AI Ark — company sourcing + lookalikes; also finds contacts/emails (secondary finder).
AI_ARK_API_KEY=
# ColdIQ — LAST-RESORT finder (40+ data providers, expensive). Only when AgenticData + AI Ark fail. Format: ciq_live_...
COLDIQ_API_KEY=

# ============================================================
# EMAIL VERIFICATION
# ============================================================
# OptimaVerifier — PRIMARY email verifier. Format: sk_live_...
OPTIMAVERIFIER_API_KEY=

# ============================================================
# SCRAPING & WEB FETCH
# ============================================================
# Apify — strategy-driven scraping (hiring, LinkedIn, Maps). MCP preferred; token for API fallback.
APIFY_TOKEN=
# Serper.dev — local business scraping (Google Places/Maps). NOT SerpApi.
SERPER_API_KEY=
# FireCrawl — website fetch/crawl/extract (PRIMARY web fetch). MCP preferred. Format: fc-...
FIRECRAWL_API_KEY=
# Open Web Ninja — FALLBACK web/news enrichment after FireCrawl (free-trial tier).
OPENWEBNINJA_KEY=

# ============================================================
# DATA STORAGE — Supabase
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server-side scripts (write)
SUPABASE_ANON_KEY=              # read-only

# ============================================================
# SENDING PLATFORM  (pick one; Plusvibe = default)
# ============================================================
PLUSVIBE_API_KEY=
SMARTLEAD_API_KEY=              # alternative

# ============================================================
# INBOX INFRASTRUCTURE
# ============================================================
# Domains — Porkbun (default). Per policy, the Porkbun key is requested from the user at RUNTIME
# when an inbox/domain change is needed, not stored here. pk1_.../sk1_...
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
DYNADOT_API_KEY=                # alternative
# Inboxes + warmup (pick one; Inboxkit = default)
INBOXKIT_API_KEY=
MAILDOSO_API_KEY=               # alternative
ZAPMAIL_API_KEY=               # alternative

# ============================================================
# SENDER IDENTITY (signatures + from-names; CAN-SPAM footer)
# ============================================================
SENDER_FIRST_NAME=
SENDER_LAST_NAME=
SENDER_TITLE=
SENDER_COMPANY_NAME=
SENDER_WEBSITE=
SENDER_PHYSICAL_ADDRESS=        # required — real mailing address, one line
